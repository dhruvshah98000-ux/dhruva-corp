# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️  SERVICE ROLE KEY — NEVER expose to the frontend or commit to Git
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# ⚠️  SECRET KEY — NEVER expose to the frontend or commit to Git
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── Razorpay Webhook ─────────────────────────────────────────────────────────
# Set this in your Razorpay Dashboard → Webhooks → Secret
# ⚠️  NEVER expose to the frontend or commit to Git
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
